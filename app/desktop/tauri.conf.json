{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "OpenDNA",
  "version": "0.6.0",
  "identifier": "org.dyber.opendna",
  "build": {
    "frontendDist": "../ui/dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": { "script": "trunk serve", "cwd": "../ui", "wait": false },
    "beforeBuildCommand": { "script": "trunk build --release", "cwd": "../ui" }
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "OpenDNA",
        "width": 1400,
        "height": 900,
        "minWidth": 1024,
        "minHeight": 680
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; worker-src 'self' blob:; font-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
    "category": "Education",
    "shortDescription": "Protein structure and sequence analysis",
    "copyright": "Copyright 2026 OpenDNA contributors",
    "publisher": "Dyber PQC",
    "homepage": "https://github.com/dyber-pqc/OpenDNA",
    "license": "Apache-2.0"
  }
}
