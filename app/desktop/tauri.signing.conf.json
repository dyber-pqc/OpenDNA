{
  "$schema": "https://schema.tauri.app/config/2",
  "bundle": {
    "windows": {
      "digestAlgorithm": "sha256",
      "timestampUrl": "http://timestamp.digicert.com",
      "signCommand": {
        "cmd": "powershell",
        "args": [
          "-NoProfile",
          "-ExecutionPolicy",
          "Bypass",
          "-File",
          "../../scripts/sign-windows.ps1",
          "%1"
        ]
      }
    }
  }
}
